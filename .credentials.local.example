# Copy to .credentials.local and fill with real values (never commit .credentials.local).
# Loaded by credentials_loader.load_credentials_local() — existing env vars are not overwritten.

# Proxmox API (one of the following styles)
# PROXMOX_API_TOKEN=PVEAPIToken=user@pam!tokenid=secret-hex
# PROXMOX_TOKEN_ID=user@pam!tokenid
# PROXMOX_TOKEN_SECRET=secret-hex

# MINDEX / website shared keys when scripts call MINDEX or Cloudflare
# MINDEX_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# SSH to Mycosoft LAN VMs (Cursor MCP `project-0-MAS-mycosoft-ssh` / deploy scripts)
# VM_PASSWORD=your-sudo-ssh-password
# (or VM_SSH_PASSWORD= — see credentials_loader if supported)

# DocuSign (CMMC / compliance / MYCA) — EMPTY placeholders only; real values in .credentials.local
DOCUSIGN_USER_ID=
DOCUSIGN_API_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://na4.docusign.net
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_APP_NAME=
DOCUSIGN_RSA_PRIVATE_KEY_PATH=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_AUTH_SERVER=https://account.docusign.com
